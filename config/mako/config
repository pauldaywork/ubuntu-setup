# Notifications. Replaces DankMaterialShell's notification service.
#
# install.sh used to *remove* mako as step 0, because DMS owned the notification
# socket and the two fought over it. That step is gone and mako is in
# lib/manifest.sh instead: with DMS uninstalled, nothing else implements the
# org.freedesktop.Notifications interface and notify-send would silently no-op.
# window-rules/toggle.sh calls notify-send on every profile switch, so that is
# immediately visible.
#
# What does not come back: DMS kept a notification *history* you could reopen
# and scroll. mako has `makoctl restore`, which brings back the most recently
# dismissed notification and nothing more. If the history mattered, that is the
# thing to go looking for a replacement for.

# Palette matches config/waybar/style.css — the "Peace & Quiet" dark theme with
# the salmon accent that DMS was themed with. See the note there about matugen:
# these no longer retint with the wallpaper.
#
# The same surface colour fuzzel's popups carry (config/fuzzel/fuzzel.ini), but
# more opaque, and that difference is load-bearing.
#
# fuzzel sits at 80 because niri blurs what is behind it. A notification is not
# blurred — see the note in config/niri/config.kdl for why the layer-rule had to
# go — so this alpha is the only thing between the text and a busy wallpaper,
# and at 80 the wallpaper reads straight through the words. cc is dark enough to
# hold the text and still translucent enough to sit on the desktop rather than
# on top of it. It was ee before any of this, which is near enough to opaque.
background-color=#130f1acc
text-color=#f0f0f0
border-color=#eda792
progress-color=over #221f26

font=Noto Sans 10
border-size=2
border-radius=8
padding=12
default-timeout=6000

# No horizontal margin, 8px underneath: top 0, sides 0, bottom 8 (see
# DIRECTIONAL VALUES in `man 5 mako`).
#
# The 8 underneath is what separates stacked notifications: without it they butt
# together, two 2px borders meeting with no gap. Nothing is painted in that gap
# now, so it is the wallpaper, sharp.
#
# The sides stay at 0 as a leftover from the blurred version, where the surface
# being wider than the pills was what drew a box around the stack. Harmless
# either way now — outer-margin below is what holds the stack off the screen
# edge, and doing it there keeps every notification the same width.
margin=0,0,8

# Top right, clear of the bar, and outer-margin rather than margin so the offset
# applies to the list as a whole rather than to every notification in it. The bar
# is 40px tall with an 8px top margin and sits in a 60px strut band (see
# config/niri/window-rules/*.kdl), so anything less than ~56 here overlaps it
# while the top bar is showing — it starts hidden, which is why 8 is liveable.
outer-margin=8
anchor=top-right
layer=overlay
width=380
height=160
max-visible=5

# Ghostty is translucent and the desktop behind it is often a busy animated GIF,
# so notifications need to be legible against anything.
[urgency=low]
border-color=#d9bcb8
default-timeout=4000

[urgency=normal]
border-color=#eda792

# Critical notifications do not time out on their own — that is the whole point
# of the urgency level, and mako's default of honouring the timeout anyway is
# the wrong call for things like "battery about to die".
[urgency=critical]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0
