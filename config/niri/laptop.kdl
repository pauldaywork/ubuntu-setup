// Laptop-specific binds, included only when install.sh is run with --laptop.
// Lived at dms/laptop.kdl until DMS was dropped — it was never a DMS file, it
// just shared the directory with the ones DMS generated.
binds {
    Super+Alt+Comma  hotkey-overlay-title="Turn off main display" { spawn "sh" "-c" "niri msg output eDP-1 off"; }
    Super+Alt+Period hotkey-overlay-title="Turn on main display"  { spawn "sh" "-c" "niri msg output eDP-1 on"; }

    Mod+Up   { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }

    Mod+Ctrl+Up   { move-column-to-workspace-up; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }
}
