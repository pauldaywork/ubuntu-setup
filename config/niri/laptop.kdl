// What only laptops get: the built-in screen and the keys that drive it.
// configure.sh deploys this on machines it takes for laptops (see "Machine
// type" in CONTEXT.md) and appends `include "laptop.kdl"` to config.kdl there;
// a desktop has neither. Lived at dms/laptop.kdl until DMS was dropped — it was
// never a DMS file, it just shared the directory with the ones DMS generated.

// The built-in screen. niri picks the highest refresh rate when the mode's is
// left off, and places the output automatically when this position would
// overlap another.
output "eDP-1" {
    mode "1920x1080@144.003"
    scale 1
    transform "normal"
    position x=1280 y=0
}

binds {
    Super+Alt+Comma  hotkey-overlay-title="Turn off main display" { spawn "sh" "-c" "niri msg output eDP-1 off"; }
    Super+Alt+Period hotkey-overlay-title="Turn on main display"  { spawn "sh" "-c" "niri msg output eDP-1 on"; }

    // brightnessctl, matching the backlight module's scroll in laptop.jsonc.
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }
}
