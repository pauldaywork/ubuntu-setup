// "focus" profile: fades unfocused windows to near-invisible, focused
// window drawn back in at partial opacity. Toggle with Mod+Alt+F.
layout {
    background-color "transparent"
    preset-column-widths {
        proportion 0.33333
        proportion 0.6
        proportion 0.8
    }
    default-column-width { proportion 0.6; }
    border {
        off
        width 4
        active-color   "#707070"      // Neutral gray
        inactive-color "#d0d0d0"      // Light gray
        urgent-color   "#cc4444"      // Softer red
    }
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    center-focused-column "always"
    always-center-single-column
    gaps 13
    // The bands the two bars sit in. Neither bar is exclusive (see
    // config/waybar/config.jsonc), so these are what actually keep windows off
    // them, and they are set by hand rather than by the bars' own heights.
    //
    // bottom is 66, and with the 13px gap below it a window's bottom edge sits
    // 79px above the screen's. The workspace row's card sits at the bottom of
    // that band, on the screen's edge. The top bar gets its clearance from its
    // 60 (40px bar, 20px clear, plus the gap). The dock sizes itself to its
    // contents, so a taller card eats the slack above it without anything
    // saying so.
    struts {
        top 60
        bottom 66
    }
}

window-rule {
    draw-border-with-background true
    block-out-from "screencast"
    variable-refresh-rate true

    focus-ring {
        on
        width 4
        active-color "#00000020"
        inactive-color "#00000020"
        urgent-color "#00000020"
    }

    tab-indicator {
        active-color "#00000000"
    }

    geometry-corner-radius 8
    clip-to-geometry true
}

// Tiled windows only — floating windows (popups, dialogs, picture-in-picture)
// are excluded so they keep their natural size instead of being stretched,
// which was cutting off buttons in short dialogs.
window-rule {
    match is-floating=false
    // max-height 1000
    // min-height 800
}

window-rule {
    opacity 0.75

    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 1.4
    }
}

window-rule {
    match is-focused=false
    background-effect {
        blur false
    }
    opacity 0.0
}
