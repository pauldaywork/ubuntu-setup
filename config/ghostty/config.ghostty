# No `command =`: every window runs your login shell, which is what lets
# ghostty inject its shell integration (and with it, new tabs and windows that
# start in the current folder). Which folder a new terminal opens in is decided
# by whoever asks for the window — Mod+Return runs `niritasks terminal`, which
# opens one in ~/Projects/<workspace>.

mouse-scroll-multiplier = 0.5
background-opacity = 0.5
background-opacity-cells = true
background-blur = 32
window-padding-x = 8
window-padding-y = 8
window-decoration = none
gtk-titlebar = false
font-size = 10
font-family = Iosevka Term Extended

# One ghostty process for every window. niritasks opens windows with
# `ghostty +new-window`, which asks this running instance over D-Bus.
gtk-single-instance = true

foreground = ffffff
background = 000000
cursor-color = #f4f4f4
selection-background = #d6d6d6
selection-foreground = #dcdcdc
# The 16 ANSI colours, carried over from the `dankcolors` theme
# DankMaterialShell used to generate, so dropping DMS does not change them.
palette = 0=#161616
palette = 1=#ff7272
palette = 2=#94f47a
palette = 3=#ffe372
palette = 4=#e7e7e7
palette = 5=#707070
palette = 6=#f4f4f4
palette = 7=#ffefef
palette = 8=#9e9292
palette = 9=#ff9f9f
palette = 10=#b9ffa5
palette = 11=#ffeda5
palette = 12=#ffffff
palette = 13=#ffffff
palette = 14=#ffffff
palette = 15=#fff8f8

cursor-style = block
cursor-style-blink = true
scrollback-limit = 3023
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false
app-notifications = no-clipboard-copy,no-config-reload

shell-integration = detect
shell-integration-features = no-cursor,sudo,title

unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = shift+enter=text:\n
