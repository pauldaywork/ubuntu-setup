// The bar. Replaces DankMaterialShell's, which was a whole Quickshell desktop
// that happened to draw one.
//
// Deliberately close to what DMS showed, so the swap is not also a relearn:
// workspaces on the left, focused window in the middle, status on the right.
// What is genuinely gone and not replaced here is DMS's notification centre,
// notepad, night-mode toggle and its click-through audio/network/bluetooth
// popovers — waybar has no equivalent, and the modules below click out to the
// same CLI tools the niri binds already use instead.
{
    "layer": "top",
    "position": "top",
    "height": 40,

    // Not exclusive, which is the one non-obvious line in this file.
    //
    // An exclusive bar asks the compositor to reserve its height, and niri
    // would shrink the window area to suit. But config/niri/window-rules/*.kdl
    // already reserve that space by hand — `struts { top 60; bottom 50; }` in
    // both profiles — because DMS's surfaces were not exclusive either. Leaving
    // this false means the bar sits in the strut band that is already being
    // held open for it, and the window geometry does not change at all as part
    // of the DMS removal.
    //
    // To reclaim that space later: set this true (or drop the line) and lower
    // `struts.top` in normal.kdl and focus.kdl to match this height.
    "exclusive": false,

    "spacing": 6,
    "margin-top": 8,
    "margin-left": 13,
    "margin-right": 13,

    "modules-left": ["niri/workspaces"],
    "modules-center": ["niri/window"],
    "modules-right": [
        "tray",
        "backlight",
        "pulseaudio",
        "network",
        "battery",
        "clock"
    ],

    // niri names workspaces, and niri-tasks leans on that heavily — Mod+Alt+P
    // opens a project on a workspace named after it. So show the name when
    // there is one and fall back to the index when there isn't, rather than
    // numbering everything and throwing the useful half away.
    "niri/workspaces": {
        "format": "{value}",
        "on-click": "activate"
    },

    "niri/window": {
        "format": "{}",
        "max-length": 90,
        "separate-outputs": true
    },

    "tray": {
        "spacing": 10,
        "icon-size": 16
    },

    // Both of these are laptop-only in practice. waybar renders nothing for a
    // battery that doesn't exist or a backlight it can't find, so they cost a
    // desktop nothing and there is no need for a second config file.
    "backlight": {
        "format": "{percent}% ☀",
        // brightnessctl, matching the XF86MonBrightness binds in config.kdl.
        "on-scroll-up": "brightnessctl --class=backlight set +5%",
        "on-scroll-down": "brightnessctl --class=backlight set 5%-"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ⚡",
        "format-icons": ["▁", "▂", "▄", "▆", "█"],
        "tooltip-format": "{timeTo}  ({power}W)"
    },

    // wpctl rather than pactl, so this agrees with the XF86Audio binds in
    // config.kdl — one tool deciding what "the default sink" means.
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "muted",
        "format-icons": { "default": ["ᴠ", "ᴠ", "ᴠ"] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-",
        "tooltip-format": "{desc}"
    },

    "network": {
        "format-wifi": "{essid} {signalStrength}%",
        "format-ethernet": "wired",
        "format-disconnected": "offline",
        "tooltip-format": "{ifname}  {ipaddr}",
        "on-click": "ghostty -e nmtui"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1
        }
    }
}
