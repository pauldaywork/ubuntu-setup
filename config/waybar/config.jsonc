// The bars. Replace DankMaterialShell's, which was a whole Quickshell desktop
// that happened to draw one.
//
// Two of them, which is why this file is a JSON array rather than the single
// object waybar also accepts: a status bar along the top, and a workspace bar
// along the bottom. Each entry's "name" becomes a CSS class on its window, so
// style.css can target them as window#waybar.waybar-top and .waybar-dock.
// It is also the layer-shell namespace, which is why both names carry the
// waybar- prefix: the layer-rule in config/niri/config.kdl matches on it, and a
// surface simply called "top" is too generic a thing to be blurring by name.
//
// Both land in strut space that config/niri/window-rules/*.kdl already holds
// open — `struts { top 60; bottom 50; }` in both profiles. The bottom 50 was
// reserved for a DMS dock and has been empty since; the workspace bar fills it
// without changing window geometry at all.
//
// What is genuinely gone and not replaced here is DMS's notification centre,
// notepad, night-mode toggle and its click-through audio/network/bluetooth
// popovers — waybar has no equivalent, and the modules below click out to the
// same CLI tools the niri binds already use instead.
[
{
    "name": "waybar-top",
    "layer": "top",
    "position": "top",
    "height": 40,

    // Not exclusive, which is the one non-obvious line in this file.
    //
    // An exclusive bar asks the compositor to reserve its height, and niri
    // would shrink the window area to suit. But the struts above already
    // reserve that space by hand, because DMS's surfaces were not exclusive
    // either. Leaving this false means each bar sits in the band that is
    // already being held open for it, and the window geometry does not change.
    //
    // To reclaim that space later: set this true on both bars (or drop the
    // line) and lower `struts.top` / `struts.bottom` in normal.kdl and
    // focus.kdl to match their heights.
    "exclusive": false,

    "spacing": 6,
    "margin-top": 8,
    "margin-left": 13,
    "margin-right": 13,

    // Workspaces moved to the bottom bar, so this one is title and status.
    "modules-left": ["niri/window"],
    "modules-center": [],
    "modules-right": [
        "tray",
        "backlight",
        "pulseaudio",
        "network",
        "battery",
        "clock"
    ],

    "niri/window": {
        "format": "{}",
        "max-length": 90,
        "separate-outputs": true
    },

    "tray": {
        "spacing": 10,
        "icon-size": 16
    },

    // Both of these are laptop-only in practice. waybar renders nothing for a
    // battery that doesn't exist or a backlight it can't find, so they cost a
    // desktop nothing and there is no need for a second config file.
    "backlight": {
        "format": "{percent}% ☀",
        // brightnessctl, matching the XF86MonBrightness binds in config.kdl.
        "on-scroll-up": "brightnessctl --class=backlight set +5%",
        "on-scroll-down": "brightnessctl --class=backlight set 5%-"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ⚡",
        "format-icons": ["▁", "▂", "▄", "▆", "█"],
        "tooltip-format": "{timeTo}  ({power}W)"
    },

    // wpctl rather than pactl, so this agrees with the XF86Audio binds in
    // config.kdl — one tool deciding what "the default sink" means.
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "muted",
        "format-icons": { "default": ["ᴠ", "ᴠ", "ᴠ"] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-",
        "tooltip-format": "{desc}"
    },

    "network": {
        "format-wifi": "{essid} {signalStrength}%",
        "format-ethernet": "wired",
        "format-disconnected": "offline",
        "tooltip-format": "{ifname}  {ipaddr}",
        "on-click": "ghostty -e nmtui"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1
        }
    }
},

// ─── the workspace bar ────────────────────────────────────────────────────────
// Lives in the 50px band at the bottom that the struts have been holding open
// since DMS's dock went. Nothing but workspaces: this is for seeing where you
// are and clicking somewhere else, and niri-tasks names workspaces after the
// project open on them (Mod+Alt+P), so the list reads as a list of what you are
// working on rather than a row of numbers.
//
// Centred rather than left-aligned. The top bar is anchored left with the window
// title, and a second left-anchored row directly under it reads as one thing
// that lost its alignment; centred, it reads as a dock.
{
    "name": "waybar-dock",
    "layer": "top",
    "position": "bottom",
    "height": 34,
    "exclusive": false,

    "spacing": 6,
    "margin-bottom": 8,
    "margin-left": 13,
    "margin-right": 13,

    "modules-left": [],
    "modules-center": ["niri/workspaces"],
    "modules-right": [],

    // niri names workspaces, and niri-tasks leans on that heavily — Mod+Alt+P
    // opens a project on a workspace named after it. So show the name when
    // there is one and fall back to the index when there isn't, rather than
    // numbering everything and throwing the useful half away.
    "niri/workspaces": {
        "format": "{value}",
        "on-click": "activate"
    }
}
]
