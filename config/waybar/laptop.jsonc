// The top bar's laptop-only modules. Deployed only on laptops, and included by
// the top bar in config.jsonc, which lists "group/laptop" among its modules; on
// a desktop this file is absent and the group is hidden. See the note by the
// include there.
{
    "group/laptop": {
        "orientation": "inherit",
        "modules": ["power-profiles-daemon", "backlight", "battery"]
    },

    // Click cycles balanced → performance → power-saver. Words rather than
    // icons, like the vol and bt pills. The daemon is power-profiles-daemon,
    // the same one `powerprofilesctl` talks to.
    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": {
            "performance": "perf",
            "balanced": "bal",
            "power-saver": "save"
        },
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}"
    },

    "backlight": {
        "format": "{percent}% ☀",
        // brightnessctl, matching the XF86MonBrightness binds in niri's laptop.kdl.
        "on-scroll-up": "brightnessctl --class=backlight set +5%",
        "on-scroll-down": "brightnessctl --class=backlight set 5%-"
    },

    "battery": {
        // The laptop's own battery and nothing else. Left unset, waybar also
        // watches peripheral batteries — a wireless mouse's hidpp_battery — and
        // aborts when one vanishes mid-watch ("Could not watch events for
        // .../hidpp_battery_0"). BAT1 is what the MSI names its battery; a laptop
        // that calls it BAT0 needs this changed, or the module stays empty there
        // and the log says "No battery named BAT1".
        "bat": "BAT1",
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ⚡",
        "format-icons": ["▁", "▂", "▄", "▆", "█"],
        "tooltip-format": "{timeTo}  ({power}W)"
    }
}
